{
  "name": "dropchad",
  "version": "0.0.0",
  "private": true,
  "description": "dropchad monorepo. Contracts live in contracts/, they are not an npm workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "sync:abi": "node packages/shared/scripts/sync-abi.mjs",
    "sync:abi:check": "node packages/shared/scripts/sync-abi.mjs --check",
    "sync:idl": "node packages/shared/scripts/sync-idl.mjs",
    "sync:idl:check": "node packages/shared/scripts/sync-idl.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.13",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
