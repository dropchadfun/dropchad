# dropchad — environment variable NAMES only.
# Copy to .env and fill locally. Never commit .env. Never put real values in this file.
# Real secrets live in KMS.

# --- chains: rpc ---
# ONE naming scheme, settled. It is `<CHAIN>_<NET>_RPC_URL`.
# Both the foundry scripts and the indexer read the same variable. The foundry scripts read it
# through `contracts/evm/foundry.toml` [rpc_endpoints]; the indexer reads the variable NAME out of
# `packages/chains/src/chains.json` and resolves it with `rpcUrlFor`.
# The old second scheme, RPC_URL_ROBINHOOD and RPC_WS_URL_ROBINHOOD, is deleted. Nothing read it.
# Testnet public endpoint is https://rpc.testnet.chain.robinhood.com. It is rate limited and it is
# NOT an archive node, so use a provider URL for anything real.
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=

# Contract verification on the testnet Blockscout explorer.
# Confirmed: the testnet explorer needs NO API key. Leave this empty.
# Kept as a name because another chain's explorer may ask for one.
ROBINHOOD_TESTNET_EXPLORER_API_KEY=

# These two are still named by `packages/chains/src/chains.json` for the Robinhood MAINNET entry,
# so they are not dead and are kept. Nothing reads them yet: the indexer only uses `rpcEnv`.
# They do not follow the scheme above. Renaming them is a change to the registry, so it is its own
# approved change.
# Archive endpoint. Only needed once we read historical state, which today we do not.
RPC_URL_ROBINHOOD_ARCHIVE=
# Second, independent provider. Failover, never the same company as primary.
RPC_URL_ROBINHOOD_FALLBACK=

# BNB Chain, id 56. Not active yet.
RPC_URL_BNB=

# Solana, same scheme. Named by `packages/chains` for `solana-devnet` and `solana`. The program is
# written and tested (contracts/solana) and not deployed anywhere yet, so nothing reads these today.
# Public devnet endpoint is https://api.devnet.solana.com, rate limited; use a provider for real work.
SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=

# --- database ---
DATABASE_URL=

# --- auth: sign in with x ---
X_CLIENT_ID=
# Reference to the KMS entry holding the client secret. Not the secret itself.
X_CLIENT_SECRET_REF=
X_CALLBACK_URL=
SESSION_SECRET=

# --- relayer (sponsored claims, gas money only) ---
RELAYER_ADDRESS=
# Reference to the KMS key that signs relayer transactions. Not a private key.
KMS_KEY_REF=

# --- app ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_CHAIN_ID=
