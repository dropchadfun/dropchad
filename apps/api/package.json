{
  "name": "@dropchad/api",
  "version": "0.0.0",
  "private": true,
  "description": "dropchad backend for frontend. Sign in with X, sessions, the read api, and the relayers for Robinhood Chain and Solana.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@dropchad/chains": "*",
    "@dropchad/shared": "*",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "2.1.4",
    "@noble/curves": "^1.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.7",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "litesvm": "^1.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
