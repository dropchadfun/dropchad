# apps/api — environment variable NAMES only.
# Copy this file to apps/api/.env and fill it in locally. Never commit .env, it is gitignored.
# Never put a real value in this file.

# --- sign in with X ---
# From the X developer console, your app -> Keys and tokens.
# The app type is Web App, which is a confidential client, so both of these are needed.
# The registered callback URLs are:
#   http://localhost:3000/api/auth/x/callback
#   https://dropchad.com/api/auth/x/callback
#   https://dropchad.fun/api/auth/x/callback
# X matches the redirect URI exactly, which is why apps/web owns 3000 in dev and rewrites /api/*
# to this api on 4000. Both APP_URL and API_URL below stay on the 3000 origin.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- sessions ---
# At least 32 characters. The HMAC key that hashes session ids and CSRF tokens before they are
# stored. Changing it logs everybody out, which is the correct behaviour.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Handle mode. The app-only bearer token from the X developer console. Never logged.
X_BEARER_TOKEN=
HANDLE_MAX_RECEIVERS=500
HANDLE_LOOKUPS_DAILY_MAX=1000
# Handle mode. The binder keys, each its own key, never a relayer
# key. Testnet only, never a value in the repo. Leave the lines
# out until the keys exist: an empty value stops the api.
# BINDER_EVM_PRIVATE_KEY=
# BINDER_EVM_ADDRESS=
# BINDER_SOLANA_SECRET=
# BINDER_SOLANA_ADDRESS=
# A bind needs an X login from the last this many seconds.
BIND_FRESH_LOGIN_SECONDS=600
# Handle mode. The least a receiver may get, in usd, by the chain's kind.
MIN_RECEIVER_USD_MAINNET=1
MIN_RECEIVER_USD_TESTNET=1
# EVM gas numbers the fee must cover: createDrop, activate and every claim.
EVM_GAS_CREATE_DROP=360000
EVM_GAS_ACTIVATE=90000
EVM_GAS_CLAIM_BATCH_BASE=86000
EVM_GAS_PER_ADDRESS_CLAIM=50000
EVM_GAS_PER_HANDLE_CLAIM=130000
# a Robinhood token drop on DropV3. Estimates from the local V3 gas report.
EVM_GAS_TOKEN_CREATE_DROP=400000
EVM_GAS_TOKEN_ACTIVATE=130000
EVM_GAS_PER_TOKEN_HANDLE_CLAIM=160000

# --- urls ---
# Where the browser is sent after a login. The frontend origin.
APP_URL=http://localhost:3000
# This api's own public origin. The X callback URL is derived from it, so it must match the
# registered callback's origin exactly.
API_URL=http://localhost:3000

# --- database ---
# Local dev is PGlite: a directory path, or memory:// for a throwaway database.
# A postgres:// URL is refused for now, on purpose, and says so.
DATABASE_URL=./.data/api

# --- chain ---
# The Robinhood testnet RPC for the relayer. Primary: the public endpoint,
# https://rpc.testnet.chain.robinhood.com. No key, no monthly quota. after the
# Alchemy quota burn.
ROBINHOOD_TESTNET_RPC_URL=

# Optional. Used only when the primary fails, for example a keyed Alchemy url. Commented out ON
# PURPOSE: uncomment it only with a real value.
# ROBINHOOD_TESTNET_RPC_URL_FALLBACK=

# --- indexer ---
# Where apps/indexer serves its read endpoints. apps/api forwards /api/drops and /api/stats there.
# Defaults to Ponder's port, http://localhost:42069.
INDEXER_URL=http://localhost:42069

# The usd price feed, Coingecko free tier. The key is optional; without it the public rate
# limit applies. Prices are frozen on a drop when it activates.
COINGECKO_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
PRICE_TTL_MS=60000

# --- chain, and the write side ---
# Which chain the create flow works on. A key from packages/chains, and it must be a chain with a
# deployed factory.
CHAIN_KEY=robinhood-testnet

# The relayer private key. LOCAL DEV, and the testnet server under the exception.
# You paste it here yourself and it never leaves this file. It is not in the repo, it is never
# printed.
# On mainnet this moves to a KMS.
# Leave it EMPTY to run the api read only: everything works except creating drops, which answer
# 503 relayer_not_configured. That is how the tests run.
RELAYER_PRIVATE_KEY=

# The address that key is expected to belong to. When set, the api derives the address from the
# key at boot and REFUSES TO START if they differ. Cheap protection against pasting the wrong
# wallet's key. Testnet relayer is 0xD736EA24684DC353Bde347fDb349c1c4dD1Ad23d.
RELAYER_ADDRESS=

# Hard ceiling on the gas limit of one createDrop. A bigger estimate is refused, not sent.
RELAYER_MAX_GAS_PER_CREATE=2000000

# Hard ceiling on the gas limit of one claimBatch of up to MAX_BATCH (20) claims.
RELAYER_MAX_GAS_PER_CLAIM_BATCH=3000000

# Hard ceiling on one claimHandle. About 79,000 measured locally.
RELAYER_MAX_GAS_PER_CLAIM_HANDLE=300000

# How much gas money the relayer may spend in one UTC day, in wei. Default 0.0005 ETH, a quarter
# of what the testnet wallet holds, so a bug cannot drain it in one run. Recorded in the database,
# so a restart does not hand it a fresh allowance.
RELAYER_DAILY_GAS_BUDGET_WEI=500000000000000

# --- solana, and its write side ---
# Which Solana cluster the write side works on. A key from packages/chains with a deployed
# program.
SOLANA_CHAIN_KEY=solana-devnet

# The devnet RPC. The public endpoint is https://api.devnet.solana.com and it is rate limited.
SOLANA_DEVNET_RPC_URL=

# The Solana relayer keypair, exactly as solana-keygen wrote it to
# ~/.config/solana/dropchad-relayer.json: a JSON array of 64 numbers. LOCAL DEV, and the devnet
# server under the exception. Pasted by you, never in the repo, never printed,
# Leave it EMPTY and the Solana write side is off; everything else still runs.
SOLANA_RELAYER_SECRET=

# The address that keypair must derive to. When set, the api REFUSES TO START on a mismatch.
# Devnet relayer is GWuNAEF8WBr94qytoN6pK9VSPPa3g3w5SamK43oJNXzP.
SOLANA_RELAYER_ADDRESS=

# Lamports the Solana relayer may spend per UTC day: fees plus the rent it fronts per drop
# Default 0.1 SOL, a fifth of the 0.5 devnet SOL it holds.
SOLANA_RELAYER_DAILY_BUDGET_LAMPORTS=100000000

# Hard ceiling on the compute unit limit of one transaction. Default 400000.
SOLANA_MAX_COMPUTE_UNITS=400000

# Priority fee, micro lamports per compute unit. Zero on devnet.
SOLANA_PRIORITY_FEE_MICROLAMPORTS=0

# --- sharing ---
# The public base url for the "post on X" link. Kept separate from APP_URL, which in dev is
# localhost: posting http://localhost:3000/d/0x... helps nobody. Defaults to the real domain.
SHARE_BASE_URL=https://dropchad.com

# --- the worker ---
# How often the worker looks again: at a drop's balance while it waits for funding, and at the job
# queue in general. Five seconds is well inside the block time of an Orbit L2 and light enough for
# a public RPC. The worker only runs at all when RELAYER_PRIVATE_KEY is set.
WATCHER_POLL_MS=5000

# --- server ---
# Defaults to 4000. apps/web listens on 3000 and rewrites /api/* here. Do not put the api on 3000
# while the web app runs: the two would fight for the port.
PORT=4000
