{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // `ponder-env.d.ts` is generated by `ponder codegen` and declares the virtual modules
  // (`ponder:registry`, `ponder:schema`, `ponder:api`). It is committed on purpose.
  "include": ["ponder.config.ts", "ponder.schema.ts", "src/**/*.ts", "test/**/*.ts", "ponder-env.d.ts"]
}
