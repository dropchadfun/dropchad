# apps/web — environment variable NAMES only. Copy to apps/web/.env.local and fill in.
# Never a secret here: this app never holds one. Login and the relayer live in apps/api.

# Where apps/api listens. Next rewrites /api/* there, server side. Default http://127.0.0.1:4000.
API_ORIGIN=http://127.0.0.1:4000

# The public GIPHY SDK key. Read by next build. Public
# by design, but never committed. Empty: no GIF picker and no GIFs.
NEXT_PUBLIC_GIPHY_SDK_KEY=
