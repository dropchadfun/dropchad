# --- secrets, first and loudest ---
.env
.env.*
!.env.example
# The pattern above has no slash, so it already matches at any depth. Spelled out anyway,
# because this is the one file that must never be committed.
apps/api/.env
*.pem
*.p12
*.pfx
*.der

# any file that even smells like a secret
*key*
*Key*
*KEY*
*secret*
*Secret*
*SECRET*
*wallet*
*Wallet*
*WALLET*
*keypair*
*Keypair*
*KEYPAIR*
# allow the harmless ones back
!**/keyboard*
!**/*.keystore.example
# Source files the patterns above caught by name, found when the server clone had none
# of them. Code only, no key material. Windows git ignores case, so `*KEY*` matched `pubkey.ts`.
# A new file with key, secret or wallet in its name is ignored too: check `git status` for it.
!apps/api/src/chain/svm/pubkey.ts
!apps/api/src/chain/svm/keypair.ts
!apps/api/src/db/migrations/0005_chain_key.sql

